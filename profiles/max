# Profile: max
# Best edit quality. Measured 3.0 GB of VRAM under llama-server.
# Base model: Qwen3.5-4B, text-only GGUF conversion by Unsloth. License: Apache
# 2.0 (commercial use permitted). Unsloth's text-only build skips the vision
# tower that other qwen3.5 builds bundle, which costs about 1.3 GB and does
# nothing for dictation.
#
# Read by gen-prompts.sh and setup.sh as KEY=value lines.
GGUF_URL=https://huggingface.co/unsloth/Qwen3.5-4B-GGUF/resolve/main/Qwen3.5-4B-Q4_K_M.gguf
GGUF_SHA256=00fe7986ff5f6b463e62455821146049db6f9313603938a70800d1fb69ef11a4
PROMPT=system_prompt.txt
EXAMPLES="examples.tsv examples-qwen.tsv"
# ChatML with thinking disabled: the reply opens with an empty <think> block,
# which is what Qwen's own template emits for enable_thinking=false. Without it
# the model reasons out loud and that text would be typed into your document.
CHAT_FORMAT=qwen-nothink
